 static GRFont* gr_font = nullptr;
 static GRFont* gr_font_menu = nullptr;
 static MinuiBackend* gr_backend = nullptr;
@@ -391,6 +402,9 @@ int gr_init_font(const char* name, GRFont** dest) {
 }
 
