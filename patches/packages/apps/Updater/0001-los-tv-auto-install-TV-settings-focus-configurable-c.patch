+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.updater.data
+
+import java.time.DayOfWeek
+
+enum class CheckScheduleMode(val storageValue: String) {
+    DAILY("daily"),
+    WEEKLY("weekly"),
+    MONTHLY("monthly");
+
+    companion object {
+        val default = WEEKLY
+
+        fun fromStorageValue(value: String?) =
+            entries.find { it.storageValue == value } ?: default
+    }
+}
+
+data class CheckSchedule(
+    val mode: CheckScheduleMode = CheckScheduleMode.default,
+    val hour: Int = 3,
+    val minute: Int = 0,
+    val dayOfWeek: DayOfWeek = DayOfWeek.SATURDAY,
+    val dayOfMonth: Int = 1,
+) {
+    init {
+        require(hour in 0..23)
+        require(minute in 0..59)
+        require(dayOfMonth in 1..31)
+    }
+}
