+package org.lineageos.updater.updatescheck
+
+import android.content.Context
+import android.util.Log
+import androidx.work.Constraints
+import androidx.work.ExistingWorkPolicy
+import androidx.work.NetworkType
+import androidx.work.OneTimeWorkRequestBuilder
+import androidx.work.WorkManager
+import androidx.work.workDataOf
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.launch
+import org.lineageos.updater.UpdaterApplication
+import org.lineageos.updater.data.CheckSchedule
+import org.lineageos.updater.data.CheckScheduleMode
+import java.time.LocalDate
+import java.time.LocalTime
+import java.time.Month
+import java.time.YearMonth
+import java.time.ZoneId
+import java.time.ZonedDateTime
+import java.time.temporal.TemporalAdjusters
+import java.util.concurrent.TimeUnit
+
+object UpdateCheckScheduler {
+    private const val TAG = "UpdateCheckScheduler"
+
+    private const val WORK_NAME_PREFIX = "update_check_scheduled_"
+    private const val WORK_TAG = "update_check_scheduled"
+    private const val LEGACY_SCHEDULED_WORK_NAME = "update_check_scheduled"
+    private const val LEGACY_PERIODIC_WORK_NAME = "update_check_periodic"
+    private const val MAX_CATCH_UP_ATTEMPTS = 3
+    private const val MISSED_GRACE_MS = 10 * 1000L
+    private const val CATCH_UP_DELAY_MINUTES = 12L
+
+    private val networkConstraints = Constraints.Builder()
+        .setRequiredNetworkType(NetworkType.CONNECTED)
+        .build()
+
+    private fun prefs(context: Context) =
+        (context.applicationContext as UpdaterApplication).userPreferencesRepository
+
+    fun nextRun(
+        schedule: CheckSchedule,
+        after: ZonedDateTime = ZonedDateTime.now(),
+    ): ZonedDateTime {
+        val zone = after.zone
+        val time = LocalTime.of(schedule.hour, schedule.minute)
+        return when (schedule.mode) {
+            CheckScheduleMode.DAILY -> {
+                var candidate = after.toLocalDate().atTime(time).atZone(zone)
+                if (!candidate.isAfter(after)) {
+                    candidate = candidate.plusDays(1)
+                }
+                candidate
+            }
+
+            CheckScheduleMode.WEEKLY -> {
+                val date = after.toLocalDate()
+                    .with(TemporalAdjusters.nextOrSame(schedule.dayOfWeek))
+                var candidate = date.atTime(time).atZone(zone)
+                if (!candidate.isAfter(after)) {
+                    candidate = date.plusWeeks(1).atTime(time).atZone(zone)
+                }
+                candidate
+            }
+
+            CheckScheduleMode.MONTHLY -> {
+                var candidate = monthlyCandidate(
+                    after.year, after.month, schedule, time, zone
+                )
+                if (!candidate.isAfter(after)) {
+                    val nextMonth = after.toLocalDate()
+                        .withDayOfMonth(1)
+                        .plusMonths(1)
+                    candidate = monthlyCandidate(
+                        nextMonth.year, nextMonth.month, schedule, time, zone
+                    )
+                }
+                candidate
+            }
+        }
+    }
+
+    fun catchUpRun(
+        schedule: CheckSchedule,
+        after: ZonedDateTime = ZonedDateTime.now(),
+    ): ZonedDateTime {
+        val regular = nextRun(schedule, after)
+        val candidate = after.plusMinutes(CATCH_UP_DELAY_MINUTES)
+        return if (candidate.isBefore(regular)) candidate else regular
+    }
+
+    suspend fun scheduleNext(
+        context: Context,
+        schedule: CheckSchedule,
+        catchUp: Boolean = false,
+        attempt: Int = 0,
+        currentWorkName: String? = null,
+    ) {
+        val now = ZonedDateTime.now()
+        val target = if (catchUp) catchUpRun(schedule, now) else nextRun(schedule, now)
+        scheduleAt(context, schedule, target, catchUp, attempt, currentWorkName)
+    }
+
+    suspend fun scheduleCatchUpSoon(
+        context: Context,
+        schedule: CheckSchedule,
+        attempt: Int = 0,
+        currentWorkName: String? = null,
+    ) {
+        val now = ZonedDateTime.now()
+        val catchUp = catchUpRun(schedule, now)
+        if (catchUp.isBefore(nextRun(schedule, now))) {
+            scheduleAt(
+                context, schedule, catchUp,
+                catchUp = true, attempt = attempt, currentWorkName = currentWorkName,
+            )
+        } else {
+            scheduleNext(context, schedule, currentWorkName = currentWorkName)
+        }
+    }
+
+    suspend fun scheduleAfterFailure(
+        context: Context,
+        schedule: CheckSchedule,
+        attempt: Int,
+        currentWorkName: String? = null,
+    ) {
+        val now = ZonedDateTime.now()
+        val regular = nextRun(schedule, now)
+        val catchUp = catchUpRun(schedule, now)
+        if (attempt < MAX_CATCH_UP_ATTEMPTS && catchUp.isBefore(regular)) {
+            Log.i(
+                TAG,
+                "Scheduling catch-up attempt ${attempt + 1} at $catchUp",
+            )
+            scheduleAt(
+                context, schedule, catchUp,
+                catchUp = true, attempt = attempt + 1, currentWorkName = currentWorkName,
+            )
+        } else {
+            Log.i(TAG, "Catch-up limit reached or next run is sooner; scheduling $regular")
+            scheduleAt(
+                context, schedule, regular,
+                catchUp = false, attempt = 0, currentWorkName = currentWorkName,
+            )
+        }
+    }
+
+    suspend fun reschedule(context: Context) {
+        val prefs = prefs(context)
+        if (prefs.getPeriodicCheckEnabled()) {
+            scheduleNext(context, prefs.getCheckSchedule())
+        } else {
+            cancel(context)
+        }
+    }
+
+    suspend fun ensureScheduled(context: Context) {
+        val prefs = prefs(context)
+        if (!prefs.getPeriodicCheckEnabled()) {
+            cancel(context)
+            return
+        }
+
+        val schedule = prefs.getCheckSchedule()
+        val now = System.currentTimeMillis()
+        val lastScheduled = prefs.getLastScheduledAt()
+        val lastSuccess = prefs.getLastSuccessAt()
+        val pendingCatchUp = prefs.getLastScheduledCatchUp()
+        val attempt = prefs.getLastScheduledAttempt()
+
+        val missed = lastScheduled > 0 &&
+                lastScheduled < now - MISSED_GRACE_MS &&
+                lastSuccess < lastScheduled
+        // A catch-up scheduled before a reboot (its timestamp may still be in
+        // the future) must survive the reboot and run after boot, not be
+        // replaced by the next regular schedule.
+        val catchUpPending = pendingCatchUp &&
+                lastScheduled > 0 &&
+                lastSuccess < lastScheduled
+
+        when {
+            (missed || catchUpPending) && attempt >= MAX_CATCH_UP_ATTEMPTS -> {
+                Log.i(TAG, "Catch-up limit reached before boot; scheduling regular check")
+                scheduleNext(context, schedule)
+            }
+
+            missed || catchUpPending -> {
+                Log.i(
+                    TAG,
+                    "Missed/failed scheduled check at $lastScheduled; " +
+                            "catch-up in $CATCH_UP_DELAY_MINUTES min after boot " +
+                            "(attempt=$attempt)",
+                )
+                scheduleCatchUpSoon(context, schedule, attempt)
+            }
+
+            else -> scheduleNext(context, schedule)
+        }
+
+        WorkManager.getInstance(context).cancelUniqueWork(LEGACY_PERIODIC_WORK_NAME)
+    }
+
+    @JvmStatic
+    fun ensureScheduledAsync(context: Context) {
+        CoroutineScope(Dispatchers.IO + SupervisorJob()).launch {
+            try {
+                ensureScheduled(context)
+            } catch (e: Exception) {
+                Log.e(TAG, "Could not ensure update check schedule", e)
+            }
+        }
+    }
+
+    @JvmStatic
+    fun rescheduleAsync(context: Context) {
+        CoroutineScope(Dispatchers.IO + SupervisorJob()).launch {
+            try {
+                reschedule(context)
+            } catch (e: Exception) {
+                Log.e(TAG, "Could not reschedule update check", e)
+            }
+        }
+    }
+
+    @JvmStatic
+    fun cancel(context: Context) {
+        CoroutineScope(Dispatchers.IO + SupervisorJob()).launch {
+            try {
+                val prefs = prefs(context)
+                prefs.getLastScheduledWorkName()?.let {
+                    WorkManager.getInstance(context).cancelUniqueWork(it)
+                }
+            } catch (e: Exception) {
+                Log.e(TAG, "Could not cancel scheduled work by name", e)
+            }
+        }
+        WorkManager.getInstance(context).cancelAllWorkByTag(WORK_TAG)
+        WorkManager.getInstance(context).cancelUniqueWork(LEGACY_SCHEDULED_WORK_NAME)
+        WorkManager.getInstance(context).cancelUniqueWork(LEGACY_PERIODIC_WORK_NAME)
+    }
+
+    private suspend fun scheduleAt(
+        context: Context,
+        schedule: CheckSchedule,
+        target: ZonedDateTime,
+        catchUp: Boolean,
+        attempt: Int,
+        currentWorkName: String?,
+    ) {
+        val now = ZonedDateTime.now()
+        val delayMs = java.time.Duration.between(now, target)
+            .toMillis()
+            .coerceAtLeast(0L)
+        val newWorkName = WORK_NAME_PREFIX +
+                "${System.currentTimeMillis()}_${target.toInstant().toEpochMilli()}"
+
+        val request = OneTimeWorkRequestBuilder<UpdatesCheckWorker>()
+            .setInitialDelay(delayMs, TimeUnit.MILLISECONDS)
+            .setConstraints(networkConstraints)
+            .addTag(WORK_TAG)
+            .setInputData(
+                workDataOf(
+                    UpdatesCheckWorker.KEY_CATCH_UP to catchUp,
+                    UpdatesCheckWorker.KEY_ATTEMPT to attempt,
+                    UpdatesCheckWorker.KEY_WORK_NAME to newWorkName,
+                )
+            )
+            .build()
+
+        val prefs = prefs(context)
+        val oldWorkName = prefs.getLastScheduledWorkName()
+        if (oldWorkName != null && oldWorkName != currentWorkName && oldWorkName != newWorkName) {
+            // Cancel only the previous queued (or superseded) work. Never cancel
+            // the worker that is currently scheduling its successor.
+            WorkManager.getInstance(context).cancelUniqueWork(oldWorkName)
+        }
+
+        WorkManager.getInstance(context).enqueueUniqueWork(
+            newWorkName,
+            ExistingWorkPolicy.REPLACE,
+            request,
+        )
+        WorkManager.getInstance(context).cancelUniqueWork(LEGACY_SCHEDULED_WORK_NAME)
+        WorkManager.getInstance(context).pruneWork()
+        prefs.setLastScheduledWorkName(newWorkName)
+        prefs.setLastScheduledAt(target.toInstant().toEpochMilli())
+        prefs.setLastScheduledCatchUp(catchUp)
+        prefs.setLastScheduledAttempt(attempt)
+
+        Log.i(
+            TAG,
+            "Scheduled update check at $target (catchUp=$catchUp, attempt=$attempt, " +
+                    "delayMs=$delayMs, work=$newWorkName)"
+        )
+    }
+
+    private fun monthlyCandidate(
+        year: Int,
+        month: Month,
+        schedule: CheckSchedule,
+        time: LocalTime,
+        zone: ZoneId,
+    ): ZonedDateTime {
+        val day = schedule.dayOfMonth.coerceAtMost(YearMonth.of(year, month).lengthOfMonth())
+        return LocalDate.of(year, month, day).atTime(time).atZone(zone)
+    }
+}
