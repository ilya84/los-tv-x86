+
+package com.android.tv.settings.connectivity;
+
+import android.content.Context;
+import android.net.ConnectivityManager;
+import android.net.LinkAddress;
+import android.net.LinkProperties;
+import android.net.Network;
+import android.net.NetworkCapabilities;
+import android.net.ProxyInfo;
+import android.net.RouteInfo;
+import android.net.wifi.WifiInfo;
+import android.net.wifi.WifiManager;
+
+import com.android.tv.settings.connectivity.setup.AdvancedOptionsFlowInfo;
+
+import java.net.Inet4Address;
+import java.net.InetAddress;
+
+/**
+ * Fills the "default" values of the advanced IP settings screens with the values the network
+ * is actually using right now.
+ *
+ * <p>When a network runs on DHCP its {@link android.net.IpConfiguration} carries no
+ * {@link android.net.StaticIpConfiguration}, so the IP/prefix/gateway/DNS screens used to fall
+ * back to the example addresses hardcoded in the resources. Mobile settings instead show the
+ * current lease, and this class brings the same behaviour to TV settings.</p>
+ */
+final class NetworkDefaults {
+    private NetworkDefaults() {
+    }
+
+    /**
+     * Stores the live address/gateway/DNS of the network being edited in the flow, so the
+     * screens can use them when the saved configuration has no static values.
+     */
+    static void apply(Context context, AdvancedOptionsFlowInfo info, NetworkConfiguration config,
+            int networkId) {
+        final boolean ethernet = config instanceof EthernetConfig;
+        if (!ethernet) {
+            // Only use the live values when we are editing the network we are connected to;
+            // otherwise they would belong to a different network.
+            final WifiManager wifiManager = context.getSystemService(WifiManager.class);
+            final WifiInfo wifiInfo = wifiManager == null ? null : wifiManager.getConnectionInfo();
+            if (wifiInfo == null || wifiInfo.getNetworkId() != networkId) {
+                return;
+            }
+        }
+
+        final ConnectivityManager connectivityManager =
+                context.getSystemService(ConnectivityManager.class);
+        if (connectivityManager == null) {
+            return;
+        }
+
+        LinkProperties best = null;
+        for (Network network : connectivityManager.getAllNetworks()) {
+            final NetworkCapabilities capabilities =
+                    connectivityManager.getNetworkCapabilities(network);
+            if (capabilities == null
+                    || !capabilities.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET)) {
+                continue;
+            }
+            final boolean matches = ethernet
+                    ? capabilities.hasTransport(NetworkCapabilities.TRANSPORT_ETHERNET)
+                    : capabilities.hasTransport(NetworkCapabilities.TRANSPORT_WIFI);
+            if (!matches) {
+                continue;
+            }
+            final LinkProperties linkProperties =
+                    connectivityManager.getLinkProperties(network);
+            if (linkProperties == null) {
+                continue;
+            }
+            // Prefer a network that is fully configured with an IPv4 address.
+            if (best == null || (hasIpv4Address(linkProperties) && !hasIpv4Address(best))) {
+                best = linkProperties;
+            }
+        }
+        if (best == null) {
+            return;
+        }
+
+        LinkAddress address = null;
+        for (LinkAddress linkAddress : best.getLinkAddresses()) {
+            if (linkAddress.getAddress() instanceof Inet4Address) {
+                address = linkAddress;
+                break;
+            }
+        }
+
+        InetAddress gateway = null;
+        for (RouteInfo route : best.getRoutes()) {
+            if (route.isDefaultRoute() && route.getGateway() instanceof Inet4Address) {
+                gateway = route.getGateway();
+                break;
+            }
+        }
+
+        info.setFallbackNetworkInfo(address, gateway, best.getDnsServers(),
+                hostBasedProxy(best.getHttpProxy()));
+    }
+
+    /** The proxy screens can only edit a host/port proxy, not a PAC script. */
+    private static ProxyInfo hostBasedProxy(ProxyInfo proxyInfo) {
+        if (proxyInfo == null || proxyInfo.getPacFileUrl() != null
+                || proxyInfo.getHost() == null) {
+            return null;
+        }
+        return proxyInfo;
+    }
+
+    private static boolean hasIpv4Address(LinkProperties linkProperties) {
+        for (LinkAddress linkAddress : linkProperties.getLinkAddresses()) {
+            if (linkAddress.getAddress() instanceof Inet4Address) {
+                return true;
+            }
+        }
+        return false;
+    }
+}
