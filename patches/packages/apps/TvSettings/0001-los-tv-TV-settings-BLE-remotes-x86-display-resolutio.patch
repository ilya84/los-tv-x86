+package com.android.tv.settings.device.audio;
+
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.SystemProperties;
+import android.text.TextUtils;
+import android.widget.Toast;
+
+import androidx.annotation.Keep;
+import androidx.leanback.preference.LeanbackPreferenceFragmentCompat;
+import androidx.preference.EditTextPreference;
+import androidx.preference.Preference;
+import androidx.preference.SwitchPreference;
+
+import com.android.tv.settings.R;
+
+import java.util.Locale;
+import java.util.regex.Pattern;
+
+/**
+ * los-tv: user control for the native audio RTP sender.
+ *
+ * The daemon owns the capture streams; this screen flips the persistent
+ * properties and shows the daemon's state/stats. Host/port changes are
+ * applied by the daemon on the fly (it restarts the UDP session).
+ */
+@Keep
+public class AudioRtpSenderFragment extends LeanbackPreferenceFragmentCompat {
+
+    private static final String PROP_ENABLED = "persist.sys.audio_rtp.enabled";
+    private static final String PROP_HOST = "persist.sys.audio_rtp.host";
+    private static final String PROP_PORT = "persist.sys.audio_rtp.port";
+    private static final String PROP_STATE = "sys.audio_rtp.state";
+    private static final String PROP_STATS = "sys.audio_rtp.stats";
+    private static final String PROP_SERVICE = "init.svc.audio-rtp-sender";
+
+    private static final String DEFAULT_HOST = "192.168.5.150";
+    private static final String DEFAULT_PORT = "5004";
+
+    private static final Pattern IPV4 = Pattern.compile(
+            "^((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.){3}"
+                    + "(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)$");
+
+    private SwitchPreference mEnabled;
+    private Preference mStatus;
+    private EditTextPreference mHost;
+    private EditTextPreference mPort;
+
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private final Runnable mPoll = new Runnable() {
+        @Override
+        public void run() {
+            updateStatus();
+            mHandler.postDelayed(this, 1000);
+        }
+    };
+
+    @Override
+    public void onCreatePreferences(Bundle savedInstanceState, String rootKey) {
+        setPreferencesFromResource(R.xml.audio_rtp_sender, rootKey);
+
+        mEnabled = findPreference("audio_rtp_enabled");
+        mStatus = findPreference("audio_rtp_status");
+        mHost = findPreference("audio_rtp_host");
+        mPort = findPreference("audio_rtp_port");
+
+        if (mEnabled != null) {
+            mEnabled.setChecked(SystemProperties.getBoolean(PROP_ENABLED, true));
+            mEnabled.setOnPreferenceChangeListener(new Preference.OnPreferenceChangeListener() {
+                @Override
+                public boolean onPreferenceChange(Preference preference, Object newValue) {
+                    final boolean enabled = (Boolean) newValue;
+                    SystemProperties.set(PROP_ENABLED, enabled ? "1" : "0");
+                    updateStatus();
+                    return true;
+                }
+            });
+        }
+
+        setupHostPort();
+        updateStatus();
+    }
+
+    private void setupHostPort() {
+        final String host = SystemProperties.get(PROP_HOST, DEFAULT_HOST);
+        final String port = SystemProperties.get(PROP_PORT, DEFAULT_PORT);
+
+        if (mHost != null) {
+            mHost.setText(host);
+            mHost.setSummary(host);
+            mHost.setOnPreferenceChangeListener(new Preference.OnPreferenceChangeListener() {
+                @Override
+                public boolean onPreferenceChange(Preference preference, Object newValue) {
+                    final String value = newValue == null ? "" : newValue.toString().trim();
+                    if (!IPV4.matcher(value).matches()) {
+                        Toast.makeText(getContext(), R.string.audio_rtp_sender_invalid_host,
+                                Toast.LENGTH_SHORT).show();
+                        return false;
+                    }
+                    SystemProperties.set(PROP_HOST, value);
+                    preference.setSummary(value);
+                    return true;
+                }
+            });
+        }
+
+        if (mPort != null) {
+            mPort.setText(port);
+            mPort.setSummary(port);
+            mPort.setOnPreferenceChangeListener(new Preference.OnPreferenceChangeListener() {
+                @Override
+                public boolean onPreferenceChange(Preference preference, Object newValue) {
+                    final String value = newValue == null ? "" : newValue.toString().trim();
+                    int parsed;
+                    try {
+                        parsed = Integer.parseInt(value);
+                    } catch (NumberFormatException e) {
+                        parsed = -1;
+                    }
+                    if (parsed < 1 || parsed > 65535) {
+                        Toast.makeText(getContext(), R.string.audio_rtp_sender_invalid_port,
+                                Toast.LENGTH_SHORT).show();
+                        return false;
+                    }
+                    final String normalized = String.valueOf(parsed);
+                    SystemProperties.set(PROP_PORT, normalized);
+                    preference.setSummary(normalized);
+                    return true;
+                }
+            });
+        }
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        mHandler.post(mPoll);
+    }
+
+    @Override
+    public void onPause() {
+        mHandler.removeCallbacks(mPoll);
+        super.onPause();
+    }
+
+    private void updateStatus() {
+        if (mStatus == null) {
+            return;
+        }
+
+        final boolean enabled = mEnabled != null && mEnabled.isChecked();
+        final String service = SystemProperties.get(PROP_SERVICE, "");
+        final String state = SystemProperties.get(PROP_STATE, "");
+        final String stats = SystemProperties.get(PROP_STATS, "");
+
+        final String pps = statValue(stats, "pps");
+        final String kbps = statValue(stats, "kbps");
+        final String errors = statValue(stats, "err");
+
+        final String text;
+        if (!"running".equals(service)) {
+            text = "Сервис не запущен ("
+                    + (TextUtils.isEmpty(service) ? "нет" : service) + ")";
+        } else if (!enabled) {
+            text = "Выключено";
+        } else if ("on".equals(state)) {
+            final StringBuilder sb = new StringBuilder("Передача идёт");
+            if (!TextUtils.isEmpty(pps)) {
+                sb.append(" · ").append(pps).append(" пакетов/с");
+            }
+            final String speed = formatSpeed(kbps);
+            if (!TextUtils.isEmpty(speed)) {
+                sb.append(" · ").append(speed);
+            }
+            if (!TextUtils.isEmpty(errors) && !"0".equals(errors)) {
+                sb.append(" · ошибок: ").append(errors);
+            }
+            text = sb.toString();
+        } else if ("starting".equals(state)) {
+            text = "Запуск…";
+        } else if ("error".equals(state)) {
+            text = "Ошибка запуска (см. logcat)";
+        } else if (TextUtils.isEmpty(state)) {
+            text = "Состояние неизвестно";
+        } else {
+            text = "Состояние: " + state;
+        }
+
+        mStatus.setSummary(text);
+    }
+
+    private static String statValue(String stats, String suffix) {
+        if (TextUtils.isEmpty(stats)) {
+            return "";
+        }
+        for (String token : stats.split("\\s+")) {
+            if (suffix.equals("err")) {
+                if (token.startsWith("err=")) {
+                    return token.substring(4);
+                }
+            } else if (token.endsWith(suffix)) {
+                return token.substring(0, token.length() - suffix.length());
+            }
+        }
+        return "";
+    }
+
+    private static String formatSpeed(String kbps) {
+        if (TextUtils.isEmpty(kbps)) {
+            return "";
+        }
+        try {
+            final double value = Double.parseDouble(kbps);
+            if (value >= 1000.0) {
+                return String.format(Locale.getDefault(), "%.2f Мбит/с", value / 1000.0);
+            }
+            return String.format(Locale.getDefault(), "%.0f кбит/с", value);
+        } catch (NumberFormatException e) {
+            return "";
+        }
+    }
+}
