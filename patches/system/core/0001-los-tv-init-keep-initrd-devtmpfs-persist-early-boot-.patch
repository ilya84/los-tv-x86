From 801b2557912330e8b08a97e9fe8d1bc25edf8540 Mon Sep 17 00:00:00 2001
From: ilya84 <kacnep.0000@gmail.com>
Date: Tue, 3 Nov 2026 13:38:38 +1000
Subject: [PATCH] los-tv: init: keep initrd devtmpfs, persist early boot log

---
 init/first_stage_init.cpp | 21 ++++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/init/first_stage_init.cpp b/init/first_stage_init.cpp
index 3070fae19..fa974cdfd 100644
--- a/init/first_stage_init.cpp
+++ b/init/first_stage_init.cpp
@@ -25,6 +25,8 @@
 #include <sys/sysmacros.h>
 #include <sys/types.h>
 #include <sys/utsname.h>
+#include <sys/vfs.h>
+
 #include <unistd.h>
 
 #include <chrono>
@@ -330,6 +332,10 @@ static std::unique_ptr<FirstStageMount> CreateFirstStageMount(const std::string&
     }
 }
 
+#ifndef DEVFS_MAGIC
+#define DEVFS_MAGIC 0x1373
+#endif
+
 int FirstStageMain(int argc, char** argv) {
     if (REBOOT_BOOTLOADER_ON_PANIC) {
         InstallRebootSignalHandlers();
@@ -348,7 +354,14 @@ int FirstStageMain(int argc, char** argv) {
     CHECKCALL(setenv("PATH", _PATH_DEFPATH, 1));
     // Get the basic filesystem setup we need put together in the initramdisk
     // on / and then we'll let the rc file figure out the rest.
-    CHECKCALL(mount("tmpfs", "/dev", "tmpfs", MS_NOSUID, "mode=0755"));
+    // los-tv: the aaropa initrd already provides a fully populated devtmpfs.
+    // On slow hardware (e3000n/AMD) Android ueventd may not repopulate a fresh
+    // /dev tmpfs in time, which breaks apexd-bootstrap, binderfs and
+    // servicemanager. Keep the initrd devtmpfs when it is already mounted.
+    struct statfs dev_statfs {};
+    if (statfs("/dev", &dev_statfs) != 0 || dev_statfs.f_type != DEVFS_MAGIC) {
+        CHECKCALL(mount("tmpfs", "/dev", "tmpfs", MS_NOSUID, "mode=0755"));
+    }
     CHECKCALL(mkdir("/dev/pts", 0755));
     CHECKCALL(mkdir("/dev/socket", 0755));
     CHECKCALL(mkdir("/dev/dm-user", 0755));
@@ -380,6 +393,12 @@ int FirstStageMain(int argc, char** argv) {
     CHECKCALL(mknod("/dev/ptmx", S_IFCHR | 0666, makedev(5, 2)));
     CHECKCALL(mknod("/dev/null", S_IFCHR | 0666, makedev(1, 3)));
 
+    // los-tv debug: persist kernel/init log to the ESP, survives reboots.
+    if (fork() == 0) {
+        execl("/system/bin/sh", "sh", "/system/etc/los-tv-kmsglog.sh", nullptr);
+        _exit(127);
+    }
+
     // These below mounts are done in first stage init so that first stage mount can mount
     // subdirectories of /mnt/{vendor,product}/.  Other mounts, not required by first stage mount,
     // should be done in rc files.
