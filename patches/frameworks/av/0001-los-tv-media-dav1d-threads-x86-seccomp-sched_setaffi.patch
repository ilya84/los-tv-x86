From 54e40af8755a15f505e2272d275b59e040b94ea7 Mon Sep 17 00:00:00 2001
From: ilya84 <kacnep.0000@gmail.com>
Date: Tue, 3 Nov 2026 13:38:39 +1000
Subject: [PATCH] los-tv: media: dav1d threads, x86 seccomp sched_setaffinity

---
 media/codec2/components/dav1d/C2SoftDav1dDec.cpp              | 2 +-
 services/mediacodec/seccomp_policy/mediaswcodec-x86.policy    | 1 +
 services/mediacodec/seccomp_policy/mediaswcodec-x86_64.policy | 1 +
 3 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/media/codec2/components/dav1d/C2SoftDav1dDec.cpp b/media/codec2/components/dav1d/C2SoftDav1dDec.cpp
index 2a0fa91326..696b9f1174 100644
--- a/media/codec2/components/dav1d/C2SoftDav1dDec.cpp
+++ b/media/codec2/components/dav1d/C2SoftDav1dDec.cpp
@@ -549,7 +549,7 @@ bool C2SoftDav1dDec::initDecoder() {
     dav1d_default_settings(&lib_settings);
     lib_settings.all_layers = 0;
     int cpu_count = GetCPUCoreCount();
-    lib_settings.n_threads = std::max(cpu_count / 2, 1);  // use up to half the cores by default.
+    lib_settings.n_threads = std::max(cpu_count - 1, 1);  // reserve one core for the rest of the system (AOSP defaulted to half the cores).
 
     int32_t numThreads =
             android::base::GetIntProperty(NUM_THREADS_DAV1D_PROPERTY, NUM_THREADS_DAV1D_DEFAULT);
diff --git a/services/mediacodec/seccomp_policy/mediaswcodec-x86.policy b/services/mediacodec/seccomp_policy/mediaswcodec-x86.policy
index 01d77781c3..dbb6f5fdba 100644
--- a/services/mediacodec/seccomp_policy/mediaswcodec-x86.policy
+++ b/services/mediacodec/seccomp_policy/mediaswcodec-x86.policy
@@ -71,6 +71,7 @@ sched_yield: 1
 # Required by mesa3d
 kcmp: 1
 sched_getaffinity: 1
+sched_setaffinity: 1
 sysinfo: 1
 
 # The mmap2/mprotect/prctl rules in this file are less restrictive than the rules
diff --git a/services/mediacodec/seccomp_policy/mediaswcodec-x86_64.policy b/services/mediacodec/seccomp_policy/mediaswcodec-x86_64.policy
index 7e678286b5..2fb481918d 100644
--- a/services/mediacodec/seccomp_policy/mediaswcodec-x86_64.policy
+++ b/services/mediacodec/seccomp_policy/mediaswcodec-x86_64.policy
@@ -71,6 +71,7 @@ sched_yield: 1
 # Required by mesa3d
 kcmp: 1
 sched_getaffinity: 1
+sched_setaffinity: 1
 sysinfo: 1
 
 # The mmap/mprotect/prctl rules in this file are less restrictive than the rules
